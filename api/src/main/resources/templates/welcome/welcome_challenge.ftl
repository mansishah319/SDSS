<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>SDSS System</title>
</head>
<style>
    @font-face {
        font-family: "Geeza-Pro";
        src: url("/static/fonts/geeza-pro.eot"); /* IE9*/
        src: url("/static/fonts/geeza-pro.eot?#iefix") format("embedded-opentype"), /* IE6-IE8 */ url("/static/fonts/geeza-pro.woff2") format("woff2"), /* chrome、firefox */ url("/static/fonts/geeza-pro.woff") format("woff"), /* chrome、firefox */ url("/static/fonts/geeza-pro.ttf") format("truetype"), /* chrome、firefox、opera、Safari, Android, iOS 4.2+*/ url("/static/fonts/geeza-pro.svg#Geeza Pro") format("svg"); /* iOS 4.1- */
    }

    @font-face {
        font-family: bukrabold;
        src: url('/static/fonts/bukra/29LTBukra-Bold.eot');
        src: url('/static/fonts/bukra/29LTBukra-Bold.eot?#iefix') format('embedded-opentype'),
        url('/static/fonts/bukra/29LTBukra-Bold.woff2') format('woff2'),
        url('/static/fonts/bukra/29LTBukra-Bold.woff') format('woff'),
        url('/static/fonts/bukra/29LTBukra-Bold.ttf') format('truetype'),
        url('/static/fonts/bukra/29LTBukra-Bold.svg#29LTBukra-Bold') format('svg');
        font-weight: bold;
        font-style: normal;
    }

    @font-face {
        font-family: bukraregular;
        src: url('/static/fonts/bukra/29LTBukra-Regular.eot');
        src: url('/static/fonts/bukra/29LTBukra-Regular.eot?#iefix') format('embedded-opentype'),
        url('/static/fonts/bukra/29LTBukra-Regular.woff2') format('woff2'),
        url('/static/fonts/bukra/29LTBukra-Regular.woff') format('woff'),
        url('/static/fonts/bukra/29LTBukra-Regular.ttf') format('truetype'),
        url('/static/fonts/bukra/29LTBukra-Regular.svg#29LTBukra-Regular') format('svg');
        font-weight: normal;
        font-style: normal;
    }
</style>

<body>


<table dir="rtl" align="center" border="0" cellpadding="0" cellspacing="0"
       style="width:600px; background-color: #fff; border-radius: 0; direction: rtl;  padding: 10px 20px;line-height: 25px; margin: 0 auto; border-collapse: separate;border-spacing: 0 10px; ">

    <tr>
        <td style="padding:10px;padding-right: 0;" colspan="2">
            <img src="data:image/png;base64, "
                 style="float: right; width: 141px; height: 48px;" alt="">
        </td>
        <td style="padding:10px;text-align: left;padding-left: 0;" colspan="2">
            <img src="data:image/png;base64, "
                 style="float: left; width:112px; height: 48px;" alt="">
        </td>
    </tr>

    <tr>
        <!-- Arabic Content Column -->
        <td colspan="2" style="text-align: right; direction: rtl; width: 50%; vertical-align: top; padding: 0;">
            <h3 style="text-align: right; direction: rtl; font-size: 18px; line-height: normal; font-family: geeza-Pro,serif; margin-bottom: 10px; font-weight: bold;">
                عزيزي ${user.fullName}،
            </h3>
            <#if contentAr?has_content>
                <p style="text-align: right; direction: rtl; font-family: geeza-Pro,serif; font-size: 12px; line-height: normal; width: 100%; margin-top: 0;">
                    ${contentAr}
                </p>
            </#if>
        </td>

        <!-- English Content Column -->
        <td colspan="2" style="text-align: left; direction: ltr; width: 50%; vertical-align: top; padding: 0;">
            <h3 style="text-align: left; direction: ltr; font-size: 16px; line-height: normal; font-family: Arial, Helvetica, sans-serif; margin-bottom: 10px;">
                Dear ${user.fullName},
            </h3>
            <#if contentEn?has_content>
                <p style="text-align: left; direction: ltr; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: normal; width: 100%; margin-top: 0;">
                    ${contentEn}
                </p>
            </#if>
        </td>
    </tr>

    <tr>
        <td><br></td>
    </tr>

    <tr>
        <td colspan="4">
            <table style="width: 100%; border: 0; cellpadding: 0; cellspacing: 0">
                <tr>
                    <td colspan="6"
                        style="background: url('data:image/png;base64, ') no-repeat;background-size: 100%;
                          height: 15px;"
                    ></td>
                </tr>
                <tr style="background-color: #fbfbfd;">
                    <td colspan="2"
                        style="width:33.3%;border-right: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px solid rgba(0, 0, 0, 0.13);font-family: geeza-Pro,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);line-height: 18px;">
                        اسم التحدي
                    </td>
                    <td colspan="2"
                        style="width:33.3%;vertical-align: top;padding: 20px  15px;border-bottom: 1px solid rgba(0, 0, 0, 0.13);font-family:Arial, Helvetica, sans-serif;font-size: 14px;text-align: center;line-height: 18px;">
                        <p style="margin: 0;font-family: geeza-Pro,serif;">
                            ${challenge.titleAr}
                        </p>
                        <hr style="border: none; border-top: 1px solid #ddd; margin: 10px 0;">
                        <p style="margin: 0;">
                            ${challenge.titleEn}
                        </p>
                    </td>
                    <td colspan="2"
                        style="width:33.3%;border-left: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px solid rgba(0, 0, 0, 0.13);font-family: bukraregular,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);text-align: left;line-height: 18px;">
                        Challenge Name
                    </td>
                </tr>
                <tr style="background-color: #fbfbfd;">
                    <td colspan="2"
                        style="width:33.3%;border-right: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family: geeza-Pro,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);line-height: 18px;">
                        تاريخ بدء التصويت
                    </td>
                    <td colspan="2"
                        style="width:33.3%;vertical-align: top;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family:Arial, Helvetica, sans-serif;font-size: 14px;text-align: center;line-height: 18px;">
                        ${challenge.startTime}
                    </td>
                    <td colspan="2"
                        style="width:33.3%;border-left: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family: bukraregular,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);text-align: left;line-height: 18px;">
                        Voting Start Date
                    </td>
                </tr>
                <tr style="background-color: #fbfbfd;">
                    <td colspan="2"
                        style="width:33.3%;border-right: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family: geeza-Pro,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);line-height: 18px;">
                        تاريخ نهاية التصويت
                    </td>
                    <td colspan="2"
                        style="width:33.3%;vertical-align: top;padding: 20px  15px;border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family:Arial, Helvetica, sans-serif;font-size: 14px;text-align: center;line-height: 18px;">
                        ${challenge.endTime}
                    </td>
                    <td colspan="2"
                        style="width:33.3%;border-left: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family: bukraregular,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);text-align: left;line-height: 18px;">
                        Voting End Date
                    </td>
                </tr>
                <tr style="background-color: #fbfbfd;">
                    <td colspan="2"
                        style="width:33.3%;border-right: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family: geeza-Pro,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);line-height: 18px;">
                        طلباتي المعلقة
                    </td>
                    <td colspan="2"
                        style="width:33.3%;vertical-align: top;padding: 20px  15px;border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family:Arial, Helvetica, sans-serif;font-size: 14px;text-align: center;line-height: 18px;">
                        <a href="${InvitationUrl}">
                            <img src="data:image/png;base64, "
                                 alt=""
                                 style="width: 20px; color: green; height: 20px;">
                        </a>
                    </td>
                    <td colspan="2"
                        style="width:33.3%;border-left: 2px solid #ececec;padding: 20px  15px; border-bottom: 1px dashed rgba(0, 0, 0, 0.13);font-family: bukraregular,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);text-align: left;line-height: 18px;">
                        My Pending Requests
                    </td>
                </tr>
                <tr style="background-color: #fbfbfd;">
                    <td colspan="2"
                        style="width:33.3%;border-right: 2px solid #ececec;padding: 20px  15px;font-family: geeza-Pro,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);line-height: 18px;">
                        تم تسجيل التحدي برقم
                    </td>
                    <td colspan="2"
                        style="width:33.3%;vertical-align: inherit;padding: 20px  15px;font-family:Arial, Helvetica, sans-serif;font-size: 14px;text-align: center;line-height: 18px;">
                        ${challenge.id}
                    </td>
                    <td colspan="2"
                        style="width:33.3%;border-left: 2px solid #ececec;padding: 20px  15px; font-family: bukraregular,serif;font-size: 13px;color: rgba(0, 0, 0, 0.6);text-align: left;line-height: 18px;">
                        Challenge ID
                    </td>
                </tr>

                <tr>
                    <td colspan="6"
                        style="background: url('data:image/png;base64, ') no-repeat;background-size: 100%; height: 15px;"
                    ></td>
                </tr>
            </table>
        </td>
    </tr>

    <tr>
        <td><br></td>
    </tr>


    <tr>
        <td>
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="74px" height="22px" alt=""></a>
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="74px" height="22px" alt=""></a>
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="74px" height="22px" alt=""></a>
        </td>

        <td colspan="2" style="text-align: center;">
            <img src="data:image/png;base64, "
                 width="39px" height="38px" alt="">
        </td>
        <td style="text-align: left;">
            <p style="margin: 0;font-size: 9px;color: #949494; font-family: bukrabold,serif;line-height: 16px;">حمــــل
                تطبيـــــــق شرطـــــــــة دبــــــــــي
            </p>
            <p style="margin: 0;font-size: 9px;color: #949494;  font-family: bukrabold,serif;">
                DOWNLOAD DUBAI POLICE APP
            </p>
        </td>
    </tr>

    <tr>
        <td colspan="4" style="border-bottom: 1px solid rgba(0, 0, 0, 0.12);">
        </td>
    <tr>


    <tr>
        <td colspan="2">
            <p style="direction: ltr; text-align: right; line-height: 16px;margin-top: 0;">
                <img src="data:image/png;base64, "
                     width="157px" height="11px" alt="">
                <img src="data:image/png;base64, "
                     width="136px" height="11px" alt="">
            </p>
        </td>

        <td colspan="2">
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="13px" height="13px"
                        style="float: left; margin-right: 10px;" alt=""></a>
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="13px" height="13px"
                        style="float: left; margin-right: 10px;" alt=""></a>
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="13px" height="13px"
                        style="float: left; margin-right: 10px;" alt=""></a>
            <a href="#" target="_blank"><img
                        src="data:image/png;base64, "
                        width="13px" height="13px"
                        style="float: left; margin-right: 10px;" alt=""></a>
            <img src="data:image/png;base64, "
                 width="83px" height="10px" style="float: left;margin-top: 2px;" alt="">

            <p style="font-family: bukrabold,serif; text-align: left;letter-spacing: 4.35px; font-size: 8px;color: rgba(0, 0, 0, 0.42);float: left; width: 100%;">
                www.dubaipolice.gov.ae
            </p>
        </td>
    </tr>

    <tr>
        <td colspan="4" style="text-align: center; line-height: 1.4;">
            <p style="margin: 0;font-family:geeza-Pro,serif; font-size: 10px;">
                جميع الحقوق محفوظة ©️ للقيادة العامة لشرطة دبي
                <span style="color:#008755;">
                اتصل بنا | ميثاق الخصوصية
            </span></p>
            <p style="margin: 0;font-family: Arial, Helvetica, sans-serif; font-size: 10px;">
                Copyright ©️ by Dubai
                Police General Headquarter.
                All Right <br>Reserved.
                <span style="color:#008755;">
                    Contact us | Privacy Policy
                </span>
            </p>
        </td>
    </tr>


</table>


</body>

</html>